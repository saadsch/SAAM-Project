from pathlib import Path
import pandas as pd

base = Path.cwd()

file_path = base / "data" / "raw" / "DS_CO2_SCOPE_1_Y_2025.xlsx"
df = pd.read_excel(file_path)


df['country_code'] = df['ISIN'].str[:2]

# Pacific countries codes
pacific_codes = [
    'AU','NZ','JP','CN','KR','ID','PH','VN','TH','MY','SG','PG','FJ'
]

df_pacific = df[df['country_code'].isin(pacific_codes)]


years = list(range(2013, 2025))

def keep_row(row):
    values = row[years]
    nan_ratio = values.isna().sum() / len(values)
    return nan_ratio <= 0.5

df_final = df_pacific[df_pacific.apply(keep_row, axis=1)]
print(f"Final df shape: {df_final.shape}")

df_pivot = df.set_index("Date").T

# Export CSV
df_final.to_csv('Co2.csv', index=False)